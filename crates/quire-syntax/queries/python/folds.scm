; quire query, MIT OR Apache-2.0.
; Definitions and compound statements fold from their header to their last line; so do
; multi-line collections and calls.

[
  (function_definition)
  (class_definition)
  (decorated_definition)
  (if_statement)
  (for_statement)
  (while_statement)
  (try_statement)
  (with_statement)
  (match_statement)
  (list)
  (dictionary)
  (set)
  (tuple)
  (argument_list)
  (parameters)
] @fold

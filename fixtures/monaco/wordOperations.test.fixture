=== WordOperations > issue #51275 - cursorWordStartLeft does not push undo/redo stack element
config: {"autoClosingPairs":[],"surroundingPairs":[],"brackets":[],"lineComment":null,"blockComment":null}
text: ""
type "f"
type "o"
type "o"
type " "
type "b"
type "a"
type "r"
type " "
type "b"
type "a"
type "z"
expectText "foo bar baz"
cmd cursorWordStartLeft
cmd cursorWordStartLeft
type "q"
expectText "foo qbar baz"
cmd undo
expectText "foo bar baz"


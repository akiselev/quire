=== EditorModel - EditableTextModel.applyEdits > issue #144
config: {"autoClosingPairs":[],"surroundingPairs":[],"brackets":[],"lineComment":null,"blockComment":null}
text: "package caddy\n\nfunc main() {\n\tfmt.Println(\"Hello World! :)\")\n}\n"
applyEdits [[1,1,6,1,"package caddy\n\nimport \"fmt\"\n\nfunc main() {\n\tfmt.Println(\"Hello World! :)\")\n}\n"]]
expectText "package caddy\n\nimport \"fmt\"\n\nfunc main() {\n\tfmt.Println(\"Hello World! :)\")\n}\n"
applyInverse
expectText "package caddy\n\nfunc main() {\n\tfmt.Println(\"Hello World! :)\")\n}\n"


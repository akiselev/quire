=== CRLF edit normalization > edit ending with \r\n should NOT be modified
config: {"autoClosingPairs":[],"surroundingPairs":[],"brackets":[],"lineComment":null,"blockComment":null}
text: "abc\r\ndef\r\n"
setEOL crlf
applyEdits [[1,1,1,4,"xyz\r\n"]]
expectLine 1 "xyz"
expectLine 2 ""
expectLine 3 "def"
expectLineCount 4

=== CRLF edit normalization > edit ending with \r NOT followed by \n should NOT be modified
config: {"autoClosingPairs":[],"surroundingPairs":[],"brackets":[],"lineComment":null,"blockComment":null}
text: "abcdef"
setEOL crlf
applyEdits [[1,1,1,4,"xyz\r"]]
expectLineCount 2


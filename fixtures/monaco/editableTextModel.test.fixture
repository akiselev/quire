=== EditorModel - EditableTextModel.applyEdits > advanced 1
config: {"autoClosingPairs":[],"surroundingPairs":[],"brackets":[],"lineComment":null,"blockComment":null}
text: " {       \"d\": [\n             null\n        ] /*comment*/\n        ,\"e\": /*comment*/ [null] }"
applyEdits [[1,1,1,2,""],[1,3,1,10,"\n  "],[1,16,2,14,"\n    "],[2,18,3,9,"\n  "],[3,22,4,9,""],[4,10,4,10,"\n  "],[4,28,4,28,"\n    "],[4,32,4,32,"\n  "],[4,33,4,34,"\n"]]
expectText "{\n  \"d\": [\n    null\n  ] /*comment*/,\n  \"e\": /*comment*/ [\n    null\n  ]\n}"
applyInverse
expectText " {       \"d\": [\n             null\n        ] /*comment*/\n        ,\"e\": /*comment*/ [null] }"


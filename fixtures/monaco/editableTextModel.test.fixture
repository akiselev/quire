=== EditorModel - EditableTextModel.applyEdits > issue #3980
config: {"autoClosingPairs":[],"surroundingPairs":[],"brackets":[],"lineComment":null,"blockComment":null}
text: "class A {\n    someProperty = false;\n    someMethod() {\n    this.someMethod();\n    }\n}"
applyEdits [[1,8,1,9,"\n"],[3,17,3,18,"\n"],[3,18,3,18,"    "],[4,5,4,5,"    "]]
expectText "class A\n{\n    someProperty = false;\n    someMethod()\n    {\n        this.someMethod();\n    }\n}"
applyInverse
expectText "class A {\n    someProperty = false;\n    someMethod() {\n    this.someMethod();\n    }\n}"


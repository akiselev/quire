=== Editor Contrib - Line Comment Command > issue #2837 "Add Line Comment" fault when blank lines involved
config: {"autoClosingPairs":[],"surroundingPairs":[],"brackets":[],"lineComment":"!@#","blockComment":["<!@#","#@!>"]}
text: "    if displayName == \"\":\n        displayName = groupName\n    description = getAttr(attributes, \"description\")\n    mailAddress = getAttr(attributes, \"mail\")\n\n    print \"||Group name|%s|\" % displayName\n    print \"||Description|%s|\" % description\n    print \"||Email address|[mailto:%s]|\" % mailAddress`"
setSelections 1 1 8 56
cmd editor.action.addCommentLine
expectText "    !@# if displayName == \"\":\n    !@#     displayName = groupName\n    !@# description = getAttr(attributes, \"description\")\n    !@# mailAddress = getAttr(attributes, \"mail\")\n\n    !@# print \"||Group name|%s|\" % displayName\n    !@# print \"||Description|%s|\" % description\n    !@# print \"||Email address|[mailto:%s]|\" % mailAddress`"
expectSel 1 1 8 60


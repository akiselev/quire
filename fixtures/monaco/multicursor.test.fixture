=== Multicursor selection > AddSelectionToNextFindMatchAction starting with all collapsed selections on different words
config: {"autoClosingPairs":[],"surroundingPairs":[],"brackets":[],"lineComment":null,"blockComment":null}
text: "abc pizza\nabc house\nabc bar"
setSelections 1 6 1 6; 2 6 2 6; 3 6 3 6
cmd editor.action.addSelectionToNextFindMatch
expectSel 1 5 1 10; 2 5 2 10; 3 5 3 8
cmd editor.action.addSelectionToNextFindMatch
expectSel 1 5 1 10; 2 5 2 10; 3 5 3 8

=== Multicursor selection > issue #20651: AddSelectionToNextFindMatchAction case insensitive
config: {"autoClosingPairs":[],"surroundingPairs":[],"brackets":[],"lineComment":null,"blockComment":null}
text: "test\ntestte\nTest\ntestte\ntest"
setSelections 1 1 1 5
cmd editor.action.addSelectionToNextFindMatch
expectSel 1 1 1 5; 2 1 2 5
cmd editor.action.addSelectionToNextFindMatch
expectSel 1 1 1 5; 2 1 2 5; 3 1 3 5
cmd editor.action.addSelectionToNextFindMatch
expectSel 1 1 1 5; 2 1 2 5; 3 1 3 5; 4 1 4 5
cmd editor.action.addSelectionToNextFindMatch
expectSel 1 1 1 5; 2 1 2 5; 3 1 3 5; 4 1 4 5; 5 1 5 5
cmd editor.action.addSelectionToNextFindMatch
expectSel 1 1 1 5; 2 1 2 5; 3 1 3 5; 4 1 4 5; 5 1 5 5

=== Multicursor selection > Find state disassociation > enters mode
config: {"autoClosingPairs":[],"surroundingPairs":[],"brackets":[],"lineComment":null,"blockComment":null}
text: "app\napples\nwhatsapp\napp\nApp\n app"
setSelections 1 2 1 2
cmd editor.action.addSelectionToNextFindMatch
expectSel 1 1 1 4
cmd editor.action.addSelectionToNextFindMatch
expectSel 1 1 1 4; 4 1 4 4
cmd editor.action.addSelectionToNextFindMatch
expectSel 1 1 1 4; 4 1 4 4; 6 2 6 5

=== Multicursor selection > Find state disassociation > leaves mode when selection changes
config: {"autoClosingPairs":[],"surroundingPairs":[],"brackets":[],"lineComment":null,"blockComment":null}
text: "app\napples\nwhatsapp\napp\nApp\n app"
setSelections 1 2 1 2
cmd editor.action.addSelectionToNextFindMatch
expectSel 1 1 1 4
cmd editor.action.addSelectionToNextFindMatch
expectSel 1 1 1 4; 4 1 4 4
setSelections 1 1 1 4
cmd editor.action.addSelectionToNextFindMatch
expectSel 1 1 1 4; 2 1 2 4


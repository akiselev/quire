=== Editor Contrib - Line Operations > multicursor 1
config: {"autoClosingPairs":[],"surroundingPairs":[],"brackets":[],"lineComment":null,"blockComment":null}
text: "class P {\n\n    getA() {\n        if (true) {\n            return \"a\";\n        }\n    }\n\n    getB() {\n        if (true) {\n            return \"b\";\n        }\n    }\n\n    getC() {\n        if (true) {\n            return \"c\";\n        }\n    }\n}"
setSelections 4 1 5 1; 10 1 11 1; 16 1 17 1
cmd editor.action.deleteLines
expectText "class P {\n\n    getA() {\n            return \"a\";\n        }\n    }\n\n    getB() {\n            return \"b\";\n        }\n    }\n\n    getC() {\n            return \"c\";\n        }\n    }\n}"
expectSel 4 1 4 1; 9 1 9 1; 14 1 14 1


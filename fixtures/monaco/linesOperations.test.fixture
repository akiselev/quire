=== Editor Contrib - Line Operations > DeleteAllLeftAction > should delete to the left of the cursor
config: {"autoClosingPairs":[],"surroundingPairs":[],"brackets":[],"lineComment":null,"blockComment":null}
text: "one\ntwo\nthree"
setSelections 1 2 1 2
cmd deleteAllLeft
expectLine 1 "ne"
setSelections 2 2 2 2; 3 2 3 2
cmd deleteAllLeft
expectLine 2 "wo"
expectLine 3 "hree"

=== Editor Contrib - Line Operations > DeleteAllLeftAction > should work in multi cursor mode
config: {"autoClosingPairs":[],"surroundingPairs":[],"brackets":[],"lineComment":null,"blockComment":null}
text: "hello\nworld\nhello world\nhello\nbonjour\nhola\nworld\nhello world"
setSelections 1 2 1 2; 1 4 1 4
cmd deleteAllLeft
expectLine 1 "lo"
setSelections 2 2 2 2; 2 4 2 5
cmd deleteAllLeft
expectLine 2 "d"
setSelections 3 2 3 5; 3 7 3 7
cmd deleteAllLeft
expectLine 3 "world"
setSelections 4 3 4 3; 4 5 5 4
cmd deleteAllLeft
expectLine 4 "jour"
setSelections 5 3 6 3; 6 5 7 5; 7 7 7 7
cmd deleteAllLeft
expectLine 5 "world"


# quire's own smoke cases for the harness (not translated from VS Code).
=== smoke: type, move, undo
text: "hello"
moveTo 1 6
type " world"
expectText "hello world"
expectCursor 1 12
cmd cursorWordLeft
expectCursor 1 7
cmd undo
expectText "hello"
cmd redo
expectText "hello world"

=== smoke: auto-close and overtype
text: ""
type "("
expectText "()"
expectCursor 1 2
type ")"
expectText "()"
expectCursor 1 3

=== smoke: enter between braces
text: "fn {}"
moveTo 1 5
type "\n"
expectText "fn {\n    \n}"
expectCursor 2 5

=== smoke: comment toggle
text: "a\n  b"
setSelections 1 1 2 4
cmd editor.action.commentLine
expectText "// a\n//   b"
cmd editor.action.commentLine
expectText "a\n  b"
